# ==============================================================================
# Dodo Payments Configuration (https://dodopayments.com)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local with real keys to GitHub.

# Your Dodo Payments API Key
# Test mode key: starts with "dodo_test_..." (Get from https://test.dodopayments.com)
# Live mode key: starts with "dodo_live_..." (Get from https://app.dodopayments.com)
DODO_PAYMENTS_API_KEY=dodo_test_your_api_key_here

# Dodo Payments Environment: 'test_mode' or 'live_mode'
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional: Webhook Secret Key for signature verification
# (Get from Dodo Dashboard -> Developer -> Webhooks)
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_key_here

# Optional: Pre-created Product ID with pay_what_you_want enabled.
# If left blank, the API route will automatically find or create a "Klarden UI Donation" product for you.
DODO_PAYMENTS_PRODUCT_ID=

# Base URL of your app for redirects after payment completion
NEXT_PUBLIC_APP_URL=http://localhost:3000
